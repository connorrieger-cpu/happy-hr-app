# Copy this file to .env.local and fill in your own values. .env.local is git-ignored.
# Without a key the app uses a free OpenStreetMap-based map instead of Google Maps.
VITE_GOOGLE_MAPS_API_KEY=
# Optional: a Map ID from Google Cloud Console (Maps > Map Management) for custom styling.
VITE_GOOGLE_MAPS_MAP_ID=
# The owner page's password (open the site with ?owner). Server-only: never prefix with VITE_.
# For local `wrangler pages dev`, put the same line in .dev.vars.
OWNER_TOKEN=
