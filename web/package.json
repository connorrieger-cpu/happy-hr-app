{
  "name": "happy-hr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "shared": "UPDATE_SHARED=1 vitest run src/shared",
    "icons": "node scripts/make-icons.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name happy-hr-beta --branch main --commit-dirty=true",
    "areas": "node scripts/build-areas.mjs",
    "sweep": "node scripts/places-sweep.mjs"
  },
  "dependencies": {
    "@vis.gl/react-google-maps": "^1.10.1",
    "maplibre-gl": "^6.16.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-map-gl": "^8.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@types/google.maps": "^3.66.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0"
  }
}
