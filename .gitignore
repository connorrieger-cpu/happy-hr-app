# Secrets: never commit. web/.env.local holds the Google Maps key and the
# owner password; web/.dev.vars holds the local owner password.
.env.local
.dev.vars
# ios/Secrets.xcconfig holds the app's Google Places key.
ios/Secrets.xcconfig

